<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (APNs). Builds are signed with a development
	     profile, which only allows "development" here; the App Store export
	     (exportArchive with the distribution profile) writes "production"
	     into the shipped app, so App Store and TestFlight builds use the
	     production APNs environment. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:recipespellbook.app</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.affluentlabs.recipespellbook</string>
	</array>
</dict>
</plist>
