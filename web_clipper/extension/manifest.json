{
  "manifest_version": 3,
  "name": "Recipe Spellbook Web Clipper",
  "short_name": "Spellbook Clipper",
  "version": "1.0.0",
  "description": "Save the recipe on the page you are viewing into the Recipe Spellbook app for Windows and Mac.",
  "homepage_url": "https://recipespellbook.app",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to Recipe Spellbook",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/recipe.js", "lib/tab.js", "background.js"]
  },
  "permissions": ["activeTab", "contextMenus", "scripting"],
  "browser_specific_settings": {
    "gecko": {
      "id": "web-clipper@recipespellbook.app",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
